# Copy to .env and adjust. Only non-secret values belong here: every
# EXPO_PUBLIC_* value is inlined into the app bundle and is readable by anyone
# who downloads the app. Secrets stay on the server.

# Where the app reaches the API.
#   Android emulator -> the host machine is 10.0.2.2
#   physical device  -> this computer's LAN IP, e.g. http://192.168.0.12:3000
#   production       -> https://api.<domain>
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
