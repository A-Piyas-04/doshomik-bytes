{
  "name": "@doshomik/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node-pg-migrate up --envPath .env -m migrations",
    "db:migrate:down": "node-pg-migrate down --envPath .env -m migrations",
    "db:types": "kysely-codegen --env-file .env",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts"
  },
  "dependencies": {
    "@doshomik/shared": "workspace:*",
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/etag": "^6.2.2",
    "@fastify/jwt": "^10.2.8",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.18",
    "kysely": "^0.29.9",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
