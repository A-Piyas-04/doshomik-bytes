# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Where clients reach this server: used in upload, media, share and email links.
# On the Android emulator, the host machine is http://10.0.2.2:3000.
PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgresql://dev@localhost:55433/doshomik
TEST_DATABASE_URL=postgresql://dev@localhost:55433/doshomik_test
DB_STATEMENT_TIMEOUT_MS=5000

# Root secret, at least 32 characters. Keys for tokens, cursors, signed URLs and 2FA secrets are
# derived from it, so changing it signs everyone out and breaks existing media links. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated Google OAuth client ids (Android, iOS, web) whose ID tokens are accepted.
# Empty turns Google sign-in off.
GOOGLE_CLIENT_IDS=

# Development only: auth is switched off while the app is being built. Requests WITHOUT an
# Authorization header act as DEV_AUTH_USER, or as the username in an `x-dev-user` header (the
# seed creates admin, learner1 and learner2). No sign-in, no two-factor step. Requests that send a
# token still use real auth. The API refuses to start with this on when NODE_ENV=production.
DEV_AUTH_BYPASS=true
DEV_AUTH_USER=admin

# Comma-separated origins allowed by CORS (the admin dashboard). The mobile app does not need CORS.
CORS_ORIGINS=http://localhost:5173

# Uploads (raw/), processed media (processed/) and worker scratch space (work/) live here.
MEDIA_DIR=media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# smtp(s)://user:password@host:port, e.g. the Hostinger mailbox. Empty writes each email to
# DEV_MAIL_DIR as a text file instead (development).
SMTP_URL=
EMAIL_FROM=Doshomik Bytes <no-reply@localhost>
DEV_MAIL_DIR=.dev-mail

# Paper ingestion by the worker (OpenAlex, Semantic Scholar, Hugging Face). The app never calls them.
PAPER_SYNC_ENABLED=true
# A team contact address for OpenAlex's polite pool (never a user's address). Optional.
OPENALEX_MAILTO=
# Free key from semanticscholar.org/product/api; without it requests share a public pool and often get 429.
SEMANTIC_SCHOLAR_API_KEY=

# Deleted accounts and posts are purged after this many days.
ACCOUNT_PURGE_DAYS=30
# Practice streaks count days in this time zone.
APP_TIMEZONE=Asia/Dhaka

# GET /v1/app/config: older apps are asked to update.
MIN_APP_VERSION_ANDROID=0.0.0
MIN_APP_VERSION_IOS=0.0.0
# Android App Links (/.well-known/assetlinks.json) and the Play Store fallback for share links.
ANDROID_PACKAGE_NAME=
ANDROID_CERT_FINGERPRINTS=

# Used by `pnpm db:seed` to create the first admin account.
SEED_ADMIN_EMAIL=admin@doshomik.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin
