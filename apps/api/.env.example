# Copy to .env and adjust.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://dev:dev@localhost:5432/doshomik
TEST_DATABASE_URL=postgresql://dev:dev@localhost:5432/doshomik_test

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=30d

# Comma-separated origins allowed by CORS (the admin dashboard). The mobile app does not need CORS.
CORS_ORIGINS=http://localhost:5173

# Uploaded files are stored here and served at MEDIA_BASE_URL.
# On the Android emulator, the host machine is http://10.0.2.2:3000.
MEDIA_DIR=media
MEDIA_BASE_URL=http://localhost:3000/media

# ffprobe checks reel duration. Leave as "ffprobe" if it is on PATH.
FFPROBE_PATH=ffprobe

# Used by `pnpm db:seed` to create the first admin account.
SEED_ADMIN_EMAIL=admin@doshomik.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin
